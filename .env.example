# Option A (quick tryout, zero setup): embedded local database
DATABASE_URL=pglite://local

# Option B (real PostgreSQL, matches README architecture):
# create a free database at https://neon.tech (no card needed) and paste its
# connection string, then run: npm run db:push
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Free Gemini API key from https://aistudio.google.com/apikey (free tier, no billing)
GEMINI_API_KEY=your-gemini-api-key
# Chat model (free tier). Default gemini-3.8-flash: the README's original
# gemini-2.5-flash is no longer available to new keys (API returns 404).
# GEMINI_MODEL=gemini-3.8-flash
# Free-tier fallbacks tried in order when the primary model is busy (429/503).
# All defaults have a verified free tier; reliability during Google congestion
# still is not guaranteed - if every model is busy the app says so honestly.
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Optional: spoken replies via ElevenLabs (OFF unless all three are set).
# Free plan: ~10,000 credits/month, ~1 credit per character, no commercial
# license, attribution required when publishing generated audio.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=voice-id-from-elevenlabs
ELEVENLABS_VOICE_ENABLED=true
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_MONTHLY_CHAR_BUDGET=2000

# Public demo fairness cap: max questions one visitor (browser cookie) may have
# ANSWERED in a rolling 24h window, counted server-side. A question that fails
# to get an answer (provider busy, error) stays in the history but does not
# count; retrying it reuses the same record instead of consuming a new slot.
# Set to 0 to disable.
DEMO_DAILY_QUESTION_CAP=30
