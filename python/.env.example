# PostgreSQL database (chat history + daily cap). Free database at
# https://neon.tech (no card needed) - paste its connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Local tryout without any setup: sqlite:///helpkart_local.db

# Free Gemini API key from https://aistudio.google.com/apikey (free tier, no billing)
GEMINI_API_KEY=your-gemini-api-key
# Chat model (free tier). Default gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash
# Free-tier fallbacks tried in order when the primary model is busy (429/503).
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Public demo fairness cap: max questions one visitor (browser cookie) may have
# ANSWERED in a rolling 24h window, counted server-side. A question that fails
# to get an answer stays in the history but does not count; retrying it reuses
# the same record instead of consuming a new slot. Set to 0 to disable.
DEMO_DAILY_QUESTION_CAP=30
